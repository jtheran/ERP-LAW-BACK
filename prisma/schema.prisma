// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  phone     String
  role      String   // "lawyer", "admin", "client"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     Case[]   @relation("UserCases")
  events    JudicialEvent[]
}

model Case {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  status       String   // "open", "closed", "in progress"
  startDate    DateTime
  endDate      DateTime?
  lawyer       User     @relation("UserCases", fields: [lawyerId], references: [id])
  lawyerId     String   @db.ObjectId
  plaintiff    Party    @relation("PlaintiffCases", fields: [plaintiffId], references: [id])
  plaintiffId  String   @db.ObjectId
  defendant    Party    @relation("DefendantCases", fields: [defendantId], references: [id])
  defendantId  String   @db.ObjectId
  documents    Document[]
  events       JudicialEvent[]
  court        Court?   @relation(fields: [courtId], references: [id])
  courtId      String?  @db.ObjectId
}

model Party {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        String   // "plaintiff" or "defendant"
  contact     String?
  address     String?
  phone       String?
  email       String?
  casesAsPlaintiff Case[] @relation("PlaintiffCases")
  casesAsDefendant Case[] @relation("DefendantCases")
}

model Document {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  url       String   // Document storage URL
  type      String   // "PDF", "Word", "Image", etc.
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Court {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String?
  phone     String?
  email     String?
  cases     Case[]
}

model JudicialEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  court     String
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String   @db.ObjectId
  date      DateTime
  createdBy User     @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId
}
